---
import { siteConfig } from "../config";
---

<section id="about" class="hud-section">
  <div class="hud-shell grid gap-8 lg:grid-cols-[0.82fr_1.18fr] lg:items-start">
    <div class="space-y-4">
      <p class="hud-kicker">Technical file</p>
      <h2 class="hud-section-title">Loadout</h2>
      <div class="hud-panel p-5">
        <div class="flex items-center justify-between border-b border-cyan-300/25 pb-4">
          <span class="text-xs font-black uppercase tracking-[0.16em] text-cyan-200">Focus</span>
          <span class="text-right font-display text-3xl font-bold uppercase text-yellow-200">EE</span>
        </div>
        <p class="mt-4 text-sm font-bold uppercase leading-relaxed text-cyan-100">
          Embedded, FPGA, PCB, optics, and EV hardware work with a hands-on lab mindset.
        </p>
      </div>
    </div>

    <div class="hud-panel p-5 sm:p-7 md:p-8">
      <p class="text-lg leading-relaxed text-cyan-50 md:text-xl">
        {siteConfig.aboutMe}
      </p>

      {
        siteConfig.skills && siteConfig.skills.length > 0 && (
          <div class="mt-8">
            <div class="mb-4 flex items-center justify-between gap-4 border-b border-cyan-300/25 pb-3">
              <h3 class="text-xl font-black uppercase text-white">Equipped Skills</h3>
              <span class="text-xs font-black uppercase tracking-[0.16em] text-yellow-200">
                {siteConfig.skills.length} Equipped
              </span>
            </div>
            <div class="flex flex-wrap gap-2.5">
              {siteConfig.skills.map((skill) => (
                <span class="loadout-chip">{skill}</span>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>
