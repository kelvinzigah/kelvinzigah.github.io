---
import { siteConfig } from "../config";
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
---

{
  hasEducation && (
    <section id="education" class="hud-section">
      <div class="hud-shell grid gap-8 lg:grid-cols-[0.88fr_1.12fr] lg:items-center">
        <div>
          <p class="hud-kicker">Training Ground</p>
          <h2 class="hud-section-title">Academy</h2>
        </div>

        <div class="space-y-5">
          {siteConfig.education.map((edu) => (
            <article class="hud-panel p-5 sm:p-7">
              <div class="flex flex-col gap-4 border-b border-cyan-300/25 pb-5 md:flex-row md:items-start md:justify-between">
                <div>
                  <p class="text-xs font-black uppercase tracking-[0.16em] text-yellow-200">Degree Track</p>
                  <h3 class="mt-2 text-2xl font-black uppercase leading-tight text-white">
                    {edu.degree}
                  </h3>
                  <p class="mt-2 text-base font-bold text-cyan-200">{edu.school}</p>
                </div>
                <span class="w-fit border-2 border-yellow-300/60 bg-yellow-300/12 px-3 py-2 text-xs font-black uppercase text-yellow-100">
                  {edu.dateRange}
                </span>
              </div>

              {edu.achievements && edu.achievements.length > 0 && (
                <ul class="mt-5 grid gap-3">
                  {edu.achievements.map((achievement) => (
                    <li class="flex gap-3 text-sm font-medium leading-relaxed text-cyan-50">
                      <span class="mt-1.5 grid h-5 w-5 shrink-0 place-items-center border border-cyan-200 text-[0.6rem] font-black text-cyan-100">
                        XP
                      </span>
                      <span>{achievement}</span>
                    </li>
                  ))}
                </ul>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}
