---
import { siteConfig } from "../config";
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
---

{
  hasExperience && (
    <section id="experience" class="hud-section">
      <div class="hud-shell grid gap-8 lg:grid-cols-[0.72fr_1.28fr]">
        <div>
          <p class="hud-kicker">Career Missions</p>
          <h2 class="hud-section-title">Mission Log</h2>
          <div class="mt-6 hidden h-56 border-l-4 border-cyan-300/45 lg:block">
            <div class="ml-4 h-full bg-gradient-to-b from-yellow-300 via-cyan-300 to-transparent opacity-70"></div>
          </div>
        </div>

        <div class="space-y-5">
          {siteConfig.experience.map((exp, index) => (
            <article class="mission-card p-5 sm:p-6">
              <div class="relative z-10 flex flex-col gap-4 pt-6 md:flex-row md:items-start md:justify-between">
                <div>
                  <span class="text-xs font-black uppercase tracking-[0.16em] text-yellow-200">
                    Mission 0{index + 1}
                  </span>
                  <h3 class="mt-2 text-2xl font-black uppercase leading-tight text-white">
                    {exp.title}
                  </h3>
                  <p class="mt-1 text-base font-black uppercase text-cyan-200">
                    {exp.company}
                  </p>
                </div>
                <span class="w-fit border-2 border-cyan-300/40 bg-cyan-300/10 px-3 py-2 text-xs font-black uppercase text-cyan-100">
                  {exp.dateRange}
                </span>
              </div>

              {exp.bullets && exp.bullets.length > 0 && (
                <ul class="relative z-10 mt-5 grid gap-3">
                  {exp.bullets.map((bullet) => (
                    <li class="flex gap-3 text-sm font-medium leading-relaxed text-cyan-50">
                      <span class="mt-2 h-2.5 w-2.5 shrink-0 rotate-45 border border-yellow-200 bg-orange-400 shadow-[0_0_16px_rgba(255,138,31,0.55)]" />
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}
