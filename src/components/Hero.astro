---
import { siteConfig } from "../config";

const socials = [
  siteConfig.social?.email && { label: "Email", href: `mailto:${siteConfig.social.email}` },
  siteConfig.social?.linkedin && { label: "LinkedIn", href: siteConfig.social.linkedin },
  siteConfig.social?.github && { label: "GitHub", href: siteConfig.social.github },
].filter(Boolean);
---

<section id="hero" class="relative isolate min-h-screen overflow-hidden px-4 pb-16 pt-28 md:px-8 md:pt-32">
  <div class="absolute inset-0 -z-20 bg-[radial-gradient(circle_at_76%_22%,rgba(248,217,74,0.12),transparent_24rem),linear-gradient(135deg,#05070c_0%,#071226_50%,#120d1f_100%)]"></div>
  <div class="absolute inset-0 -z-10 opacity-45 mix-blend-screen [background-image:radial-gradient(rgba(255,255,255,0.22)_1px,transparent_1px)] [background-size:18px_18px]"></div>

  <div class="hud-shell grid min-h-[calc(100vh-9rem)] items-center gap-10 lg:grid-cols-[0.96fr_1.04fr]">
    <div class="relative z-10 max-w-3xl">
      <p class="comic-kicker">Engineering dossier online</p>
      <h1 class="comic-title mt-5">
        {siteConfig.name}
      </h1>
      <p class="mt-5 max-w-2xl font-display text-2xl font-bold uppercase leading-tight text-signal-yellow md:text-4xl">
        {siteConfig.title}
      </p>
      <p class="mt-6 max-w-2xl text-base font-semibold leading-relaxed text-archive-paper/86 md:text-lg">
        Embedded systems, PCB design, FPGA development, and EV hardware work presented as a cinematic project archive.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#projects" class="comic-button"><span>Open Project Files</span></a>
        <a href="#about" class="comic-button comic-button-secondary"><span>View Loadout</span></a>
      </div>

      {socials.length > 0 && (
        <div class="mt-7 flex flex-wrap gap-3">
          {socials.map((social) => (
            <a
              href={social.href}
              target={social.label === "Email" ? undefined : "_blank"}
              rel={social.label === "Email" ? undefined : "noopener noreferrer"}
              class="comic-link"
            >
              {social.label}
            </a>
          ))}
        </div>
      )}
    </div>

    <div class="relative">
      <div class="absolute -left-6 top-10 hidden h-28 w-28 border-4 border-signal-yellow/80 md:block [clip-path:polygon(0_0,100%_18%,78%_100%,0_82%)]"></div>
      <div class="dossier-visual">
        <img
          src="/media/ultrahd-buck-converter.jpg"
          alt="Electronics project board used as a temporary engineering visual"
          class="h-full w-full object-cover opacity-82 mix-blend-luminosity"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-archive-black/88 via-archive-black/25 to-transparent"></div>
        <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(32,231,255,0.16)_1px,transparent_1px),linear-gradient(rgba(32,231,255,0.12)_1px,transparent_1px)] bg-[size:42px_42px] opacity-55"></div>
        <div class="absolute bottom-5 left-5 right-5 border-l-4 border-signal-yellow bg-archive-black/78 p-4 backdrop-blur-sm">
          <p class="text-xs font-black uppercase tracking-[0.18em] text-electric-cyan">Current class</p>
          <p class="mt-1 font-display text-2xl font-bold uppercase text-archive-paper">Hardware Systems Builder</p>
        </div>
      </div>
      <div class="absolute -bottom-5 right-4 border-2 border-electric-cyan bg-archive-black px-4 py-3 shadow-[8px_8px_0_rgba(248,217,74,0.8)]">
        <p class="text-xs font-black uppercase tracking-[0.16em] text-signal-yellow">Signal</p>
        <p class="font-display text-xl font-bold uppercase text-archive-paper">Ready for review</p>
      </div>
    </div>
  </div>
</section>
