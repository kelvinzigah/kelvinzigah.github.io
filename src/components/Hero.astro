---
import { siteConfig } from "../config";

const socials = [
  siteConfig.social?.email && { label: "Email", href: `mailto:${siteConfig.social.email}` },
  siteConfig.social?.linkedin && { label: "LinkedIn", href: siteConfig.social.linkedin },
  siteConfig.social?.twitter && { label: "X", href: siteConfig.social.twitter },
  siteConfig.social?.github && { label: "GitHub", href: siteConfig.social.github },
].filter(Boolean);
---

<section id="hero" class="relative isolate min-h-screen overflow-hidden px-4 pb-16 pt-28 md:px-8 md:pt-32">
  <div class="absolute inset-x-0 top-24 -z-10 h-28 bg-cyan-300/15 blur-3xl"></div>
  <div class="absolute bottom-10 right-[8%] -z-10 h-56 w-56 rounded-full bg-orange-400/20 blur-3xl"></div>

  <div class="hud-shell grid min-h-[calc(100vh-9rem)] items-center gap-8 lg:grid-cols-[1.08fr_0.92fr]">
    <div class="space-y-8">
      <div class="hud-panel max-w-2xl p-5 sm:p-7 md:p-9">
        <div class="mb-6 flex items-center gap-3 text-xs font-black uppercase tracking-[0.16em] text-yellow-200">
          <span class="h-3 w-3 animate-pulse bg-yellow-300 shadow-[0_0_22px_rgba(255,230,77,0.8)]"></span>
          Loading player profile
        </div>
        <h1 class="text-stroke text-5xl font-black uppercase leading-[0.88] text-white sm:text-6xl md:text-8xl">
          {siteConfig.name}
        </h1>
        <p class="mt-6 max-w-xl text-lg font-bold uppercase leading-relaxed text-cyan-100 md:text-2xl">
          {siteConfig.title}
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#projects" class="hud-button"><span>Start Quests</span></a>
          <a
            href="#about"
            class="inline-flex min-h-12 items-center justify-center border-2 border-cyan-300/60 bg-cyan-300/10 px-5 text-sm font-black uppercase text-cyan-100 transition hover:bg-cyan-300/20"
          >
            View Loadout
          </a>
        </div>
      </div>

      {
        socials.length > 0 && (
          <div class="flex flex-wrap gap-3">
            {socials.map((social) => (
              <a
                href={social.href}
                target={social.label === "Email" ? undefined : "_blank"}
                rel={social.label === "Email" ? undefined : "noopener noreferrer"}
                class="border-2 border-white/15 bg-white/8 px-4 py-2 text-xs font-black uppercase text-cyan-100 transition hover:border-yellow-300 hover:text-yellow-200"
              >
                {social.label}
              </a>
            ))}
          </div>
        )
      }
    </div>

    <div class="relative">
      <div class="hud-panel p-4 sm:p-6">
        <div class="mb-4 flex items-center justify-between border-b border-cyan-300/25 pb-4">
          <div>
            <p class="text-xs font-black uppercase tracking-[0.18em] text-cyan-200">Status</p>
            <p class="text-2xl font-black uppercase text-yellow-200">Ready</p>
          </div>
          <div class="text-right">
            <p class="text-xs font-black uppercase tracking-[0.18em] text-cyan-200">Class</p>
            <p class="text-lg font-black uppercase text-white">Hardware Builder</p>
          </div>
        </div>

        <div class="relative aspect-[4/5] overflow-hidden border-2 border-cyan-300/40 bg-gradient-to-b from-[#1d6fff] via-[#123a7a] to-[#07172d]">
          <div class="absolute inset-x-8 bottom-0 top-12 bg-cyan-200/15 blur-2xl"></div>
          <div class="absolute left-1/2 top-10 h-28 w-28 -translate-x-1/2 rounded-full border-4 border-yellow-200 bg-cyan-200 shadow-[0_0_45px_rgba(32,231,255,0.5)]"></div>
          <div class="absolute left-1/2 top-32 h-52 w-40 -translate-x-1/2 bg-yellow-300 shadow-[12px_12px_0_rgba(0,0,0,0.3)] [clip-path:polygon(18%_0,82%_0,100%_100%,0_100%)]"></div>
          <div class="absolute left-1/2 top-52 h-28 w-56 -translate-x-1/2 border-4 border-cyan-200 bg-[#0b244d] shadow-[8px_8px_0_rgba(0,0,0,0.35)] [clip-path:polygon(8%_0,92%_0,100%_100%,0_100%)]"></div>
          <div class="absolute bottom-0 left-1/2 h-36 w-72 -translate-x-1/2 bg-orange-400 [clip-path:polygon(10%_0,90%_0,100%_100%,0_100%)]"></div>
          <div class="absolute inset-x-5 bottom-5 border-2 border-white/25 bg-[#061327]/70 p-3">
            <p class="text-xs font-black uppercase tracking-[0.16em] text-cyan-200">Queue</p>
            <p class="mt-1 text-lg font-black uppercase text-white">Engineering Arena</p>
          </div>
        </div>
      </div>

      <div class="absolute -bottom-5 -left-3 border-2 border-yellow-300 bg-[#061327] px-4 py-3 shadow-[6px_6px_0_#ff8a1f]">
        <p class="text-xs font-black uppercase tracking-[0.16em] text-cyan-200">Matchmaking</p>
        <p class="text-lg font-black uppercase text-yellow-200">Systems Online</p>
      </div>
    </div>
  </div>
</section>
