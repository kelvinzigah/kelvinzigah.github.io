---
import { siteConfig } from "../config";

const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;

const themeClasses = {
  cyan: "from-cyan-300/20 via-sky-500/10 to-cyan-950/40 border-cyan-200/50",
  amber: "from-yellow-300/24 via-orange-500/12 to-yellow-950/30 border-yellow-200/55",
  orange: "from-orange-300/24 via-amber-500/12 to-orange-950/35 border-orange-200/55",
};
---

{
  hasProjects && (
    <section id="projects" class="hud-section">
      <div class="hud-shell">
        <div class="mb-8 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="hud-kicker">Project Dossier</p>
            <h2 class="hud-section-title">Projects</h2>
          </div>
          <p class="max-w-md text-sm font-bold uppercase leading-relaxed text-cyan-100">
            Open a dossier to inspect the build context, toolchain, and source path.
          </p>
        </div>

        <div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_21rem]">
          <div class="hud-panel min-h-[34rem] p-4 sm:p-5 lg:p-6">
            {siteConfig.projects.map((project, index) => {
              const isActive = index === 0;
              const themeClass =
                themeClasses[project.fallbackTheme as keyof typeof themeClasses] ?? themeClasses.cyan;

              return (
                <article
                  id={`project-dossier-${project.slug}`}
                  class={`project-dossier ${isActive ? "block" : "hidden"}`}
                  data-project-panel={project.slug}
                  role="tabpanel"
                  aria-labelledby={`project-tab-${project.slug}`}
                  hidden={!isActive}
                >
                  <div class="grid gap-5 xl:grid-cols-[minmax(0,0.92fr)_minmax(22rem,1fr)]">
                    <div
                      class={`relative min-h-[20rem] overflow-hidden border-2 bg-gradient-to-br ${themeClass}`}
                    >
                      <img
                        src={project.image}
                        alt=""
                        class="absolute inset-0 h-full w-full object-cover"
                        loading={isActive ? "eager" : "lazy"}
                      />
                      <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-[#061327] via-[#061327]/78 to-transparent p-5 pt-20">
                        <p class="text-xs font-black uppercase tracking-[0.16em] text-yellow-200">
                          Dossier 0{index + 1}
                        </p>
                        <h3 class="mt-2 max-w-xl text-3xl font-black uppercase leading-none text-white md:text-4xl">
                          {project.name}
                        </h3>
                      </div>
                    </div>

                    <div class="flex min-h-[20rem] flex-col">
                      <div class="mb-5 flex flex-wrap items-center gap-2">
                        <span class="loadout-chip">{project.category}</span>
                        <span class="loadout-chip">{project.shortName}</span>
                      </div>

                      <p class="text-sm font-medium leading-relaxed text-cyan-50 md:text-base">
                        {project.description}
                      </p>

                      {project.skills && project.skills.length > 0 && (
                        <div class="mt-7">
                          <p class="mb-3 text-xs font-black uppercase tracking-[0.16em] text-cyan-200">
                            Toolchain
                          </p>
                          <div class="flex flex-wrap gap-2">
                            {project.skills.map((skill) => (
                              <span class="border border-yellow-300/55 bg-yellow-300/12 px-2.5 py-1 text-xs font-black uppercase text-yellow-100">
                                {skill}
                              </span>
                            ))}
                          </div>
                        </div>
                      )}

                      <div class="mt-auto pt-7">
                        {project.link ? (
                          <a
                            class="hud-button"
                            href={project.link}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            <span>{project.repoLabel ?? "View Project"}</span>
                          </a>
                        ) : (
                          <p class="border-l-4 border-cyan-200/70 pl-4 text-xs font-black uppercase leading-relaxed tracking-[0.14em] text-cyan-100">
                            Local build notes only. Repository link pending.
                          </p>
                        )}
                      </div>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>

          <div class="quest-card flex min-h-[22rem] flex-col p-4">
            <div class="relative z-10 mb-4 pt-8">
              <p class="text-xs font-black uppercase tracking-[0.16em] text-yellow-200">
                Archive Strip
              </p>
              <h3 class="mt-2 text-2xl font-black uppercase leading-none text-white">
                Select Build
              </h3>
            </div>

            <div class="relative z-10 flex gap-3 overflow-x-auto pb-2 lg:flex-col lg:overflow-visible" role="tablist" aria-label="Project dossiers">
              {siteConfig.projects.map((project, index) => (
                <button
                  id={`project-tab-${project.slug}`}
                  type="button"
                  role="tab"
                  class={`project-tab group min-w-[15rem] border-2 p-3 text-left transition duration-200 lg:min-w-0 ${
                    index === 0
                      ? "border-yellow-200 bg-yellow-200/15"
                      : "border-cyan-200/35 bg-cyan-200/8 hover:border-yellow-200/80 hover:bg-yellow-200/10"
                  }`}
                  data-project-tab={project.slug}
                  aria-controls={`project-dossier-${project.slug}`}
                  aria-selected={index === 0 ? "true" : "false"}
                >
                  <span class="block text-xs font-black uppercase tracking-[0.16em] text-cyan-200">
                    0{index + 1} / {project.category}
                  </span>
                  <span class="mt-2 block text-lg font-black uppercase leading-tight text-white">
                    {project.shortName}
                  </span>
                  <span class="mt-3 block max-h-0 overflow-hidden text-xs font-bold leading-relaxed text-cyan-50 opacity-0 transition-all duration-200 group-aria-selected:max-h-24 group-aria-selected:opacity-100">
                    {project.name}
                  </span>
                </button>
              ))}
            </div>
          </div>
        </div>
      </div>

      <script is:inline>
        {`
          const projectTabs = Array.from(document.querySelectorAll("[data-project-tab]"));
          const projectPanels = Array.from(document.querySelectorAll("[data-project-panel]"));

          projectTabs.forEach((tab) => {
            tab.addEventListener("click", () => {
              const activeSlug = tab.getAttribute("data-project-tab");

              projectTabs.forEach((item) => {
                const isActive = item.getAttribute("data-project-tab") === activeSlug;
                item.setAttribute("aria-selected", String(isActive));
                item.classList.toggle("border-yellow-200", isActive);
                item.classList.toggle("bg-yellow-200/15", isActive);
                item.classList.toggle("border-cyan-200/35", !isActive);
                item.classList.toggle("bg-cyan-200/8", !isActive);
              });

              projectPanels.forEach((panel) => {
                const isActive = panel.getAttribute("data-project-panel") === activeSlug;
                panel.hidden = !isActive;
                panel.classList.toggle("hidden", !isActive);
                panel.classList.toggle("block", isActive);
              });
            });
          });
        `}
      </script>
    </section>
  )
}
