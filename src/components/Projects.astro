---
import { siteConfig } from "../config";
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
---

{
  hasProjects && (
    <section id="projects" class="hud-section">
      <div class="hud-shell">
        <div class="mb-8 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="hud-kicker">Quest Board</p>
            <h2 class="hud-section-title">Projects</h2>
          </div>
          <p class="max-w-md text-sm font-bold uppercase leading-relaxed text-cyan-100">
            Select a quest card to inspect the build, tools, and deployment path.
          </p>
        </div>

        <div class="grid gap-5 lg:grid-cols-3">
          {siteConfig.projects.map((project, index) => {
            const Component = project.link ? "a" : "div";
            const linkProps = project.link
              ? {
                  href: project.link,
                  target: "_blank",
                  rel: "noopener noreferrer",
                }
              : {};

            return (
              <Component
                {...linkProps}
                class={`quest-card group flex min-h-[27rem] flex-col p-5 transition duration-300 ${
                  project.link ? "hover:-translate-y-1 hover:border-yellow-300 hover:shadow-[0_24px_58px_rgba(255,138,31,0.22)]" : ""
                }`}
              >
                <div class="relative z-10 mb-8 flex items-start justify-between gap-4 pt-8">
                  <div>
                    <span class="text-sm font-black uppercase tracking-[0.16em] text-yellow-200">
                      Quest 0{index + 1}
                    </span>
                    <h3 class="mt-3 text-2xl font-black uppercase leading-tight text-white">
                      {project.name}
                    </h3>
                  </div>
                  {project.link && (
                    <span class="grid h-11 w-11 shrink-0 place-items-center border-2 border-cyan-200 bg-cyan-200 text-[#061327] transition group-hover:bg-yellow-200">
                      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M7 17L17 7M17 7H8M17 7V16" />
                      </svg>
                    </span>
                  )}
                </div>

                <p class="relative z-10 text-sm font-medium leading-relaxed text-cyan-50">
                  {project.description}
                </p>

                {project.skills && project.skills.length > 0 && (
                  <div class="relative z-10 mt-auto pt-7">
                    <p class="mb-3 text-xs font-black uppercase tracking-[0.16em] text-cyan-200">
                      Reward Tools
                    </p>
                    <div class="flex flex-wrap gap-2">
                      {project.skills.map((skill) => (
                        <span class="border border-yellow-300/55 bg-yellow-300/12 px-2.5 py-1 text-xs font-black uppercase text-yellow-100">
                          {skill}
                        </span>
                      ))}
                    </div>
                  </div>
                )}
              </Component>
            );
          })}
        </div>
      </div>
    </section>
  )
}
